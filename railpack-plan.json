{
    "language": "Python",
    "python_version": "3.12",
    "build": "pip install --upgrade pip && pip install -r backend/requirements.txt",
    "start": "uvicorn backend.main:app --host 0.0.0.0 --port 8080",
    "watch": [ "backend/", "agent/" ],
    "env": {
        "PYTHONUNBUFFERED": "1"
    }
}
